--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3dad4aa2da9780149830cdc74b61d81d, type: 3}
  m_Name: Dialogue_Dvornik1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: "\u0414\u043C\u0438\u0442\u0440\u0438\u0439 \u041D\u0438\u043A\u043E\u043B\u0430\u0435\u0432\u0438\u0447"
    portrait: {fileID: 21300000, guid: 9ad558a203201074bb13cb55cd3f9177, type: 3}
    text: "\u0421\u043A\u0430\u0436\u0438\u0442\u0435, \u0432\u044B \u0434\u0430\u0432\u043D\u043E
      \u0437\u0434\u0435\u0441\u044C \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442\u0435?"
    voiceSoundName: sound_man1
  - speakerName: "\u0411\u0443\u0434\u043E\u0447\u043D\u0438\u043A"
    portrait: {fileID: 21300000, guid: 21a4fe3508552fe49b06b01642bf5f81, type: 3}
    text: "\u0414\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E. \u0410 \u0447\u0442\u043E,
      \u0445\u043E\u0442\u0438\u0442\u0435 \u0447\u0442\u043E-\u0442\u043E \u0443\u0437\u043D\u0430\u0442\u044C?"
    voiceSoundName: sound_man2
  - speakerName: "\u0414\u043C\u0438\u0442\u0440\u0438\u0439 \u041D\u0438\u043A\u043E\u043B\u0430\u0435\u0432\u0438\u0447"
    portrait: {fileID: 21300000, guid: 9ad558a203201074bb13cb55cd3f9177, type: 3}
    text: "\u0412\u044B \u0440\u0430\u043D\u044C\u0448\u0435 \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u043B\u0438
      \u0437\u0434\u0435\u0441\u044C \u043C\u043E\u043B\u043E\u0434\u043E\u0433\u043E
      \u043E\u0444\u0438\u0446\u0435\u0440\u0430, \u0447\u0442\u043E \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B
      \u043A \u0434\u043E\u043C\u0443 \u0433\u0440\u0430\u0444\u0438\u043D\u0438?"
    voiceSoundName: sound_man3
  - speakerName: "\u0411\u0443\u0434\u043E\u0447\u043D\u0438\u043A"
    portrait: {fileID: 21300000, guid: 21a4fe3508552fe49b06b01642bf5f81, type: 3}
    text: "\u041D\u0430\u0431\u043B\u044E\u0434\u0430\u043B, \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u043B\u2026
      \u041E\u043D \u0447\u0430\u0441\u0442\u043E \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B.
      \u0421\u0442\u043E\u044F\u043B \u043F\u043E\u0434\u043E\u043B\u0433\u0443,
      \u0432 \u043E\u043A\u043D\u0430 \u0437\u0430\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u043B,
      \u0431\u0443\u0434\u0442\u043E \u043A\u043E\u0433\u043E-\u0442\u043E \u0432\u044B\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u043B."
    voiceSoundName: 
  - speakerName: "\u0414\u043C\u0438\u0442\u0440\u0438\u0439 \u041D\u0438\u043A\u043E\u043B\u0430\u0435\u0432\u0438\u0447"
    portrait: {fileID: 21300000, guid: 9ad558a203201074bb13cb55cd3f9177, type: 3}
    text: "\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044E."
    voiceSoundName: sound_man4
