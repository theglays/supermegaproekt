  itemName: "\u041A\u043D\u0438\u0436\u043D\u044B\u0439 \u0448\u043A\u0430\u0444"
  interactionDescription: "\u041A\u043E\u0440\u0435\u0448\u043A\u0438 \u0432 \u0442\u0451\u043C\u043D\u043E\u0439
    \u043A\u043E\u0436\u0435: \u201E\u0418\u0441\u0442\u043E\u0440\u0438\u044F \u0413\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0430
    \u0420\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u043E\u0433\u043E\u201C \u041A\u0430\u0440\u0430\u043C\u0437\u0438\u043D\u0430,
    \u0444\u0440\u0430\u043D\u0446\u0443\u0437\u0441\u043A\u0438\u0435 \u0440\u043E\u043C\u0430\u043D\u044B,
    \u0443\u0441\u0442\u0430\u0432\u044B \u0438 \u0430\u0442\u043B\u0430\u0441\u044B.
    \u041E\u0444\u0438\u0446\u0435\u0440\u0441\u043A\u0430\u044F \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0430,
    \u0433\u0434\u0435 \u0441\u043C\u0435\u0448\u0430\u043B\u0438\u0441\u044C \u0441\u043B\u0443\u0436\u0431\u0430
    \u0438 \u043F\u0440\u043E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u0435."
