%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3dad4aa2da9780149830cdc74b61d81d, type: 3}
  m_Name: Dialogue_Dvornik2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: "\u0414\u043C\u0438\u0442\u0440\u0438\u0439 \u041D\u0438\u043A\u043E\u043B\u0430\u0435\u0432\u0438\u0447"
    portrait: {fileID: 21300000, guid: 9ad558a203201074bb13cb55cd3f9177, type: 3}
    text: "\u0421\u043A\u0430\u0436\u0438\u0442\u0435, \u043B\u044E\u0431\u0435\u0437\u043D\u044B\u0439,
      \u0441\u0435\u0439\u0447\u0430\u0441 \u0432 \u044D\u0442\u043E\u043C \u0434\u043E\u043C\u0435
      \u043A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u0436\u0438\u0432\u0451\u0442?"
    voiceSoundName: sound_man1
  - speakerName: "\u0411\u0443\u0434\u043E\u0447\u043D\u0438\u043A"
    portrait: {fileID: 21300000, guid: 21a4fe3508552fe49b06b01642bf5f81, type: 3}
    text: "\u0420\u0435\u0434\u043A\u043E, \u0441\u0443\u0434\u0430\u0440\u044C.
      \u041F\u043E\u0441\u043B\u0435 \u0441\u043C\u0435\u0440\u0442\u0438 \u0433\u0440\u0430\u0444\u0438\u043D\u0438
      \u043D\u0430\u0441\u043B\u0435\u0434\u043D\u0438\u043A\u0438 \u043F\u0440\u0438\u043D\u044F\u043B\u0438
      \u0434\u043E\u043C, \u0434\u0430 \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
      \u0437\u0434\u0435\u0441\u044C \u043D\u0435\u0447\u0430\u0441\u0442\u043E."
    voiceSoundName: sound_man2
  - speakerName: "\u0414\u043C\u0438\u0442\u0440\u0438\u0439 \u041D\u0438\u043A\u043E\u043B\u0430\u0435\u0432\u0438\u0447"
    portrait: {fileID: 21300000, guid: 9ad558a203201074bb13cb55cd3f9177, type: 3}
    text: "\u0421\u0442\u0430\u043B\u043E \u0431\u044B\u0442\u044C, \u0431\u043E\u043B\u044C\u0448\u0443\u044E
      \u0447\u0430\u0441\u0442\u044C \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043E\u043D
      \u043F\u0443\u0441\u0442\u0443\u0435\u0442?"
    voiceSoundName: sound_man3
  - speakerName: "\u0411\u0443\u0434\u043E\u0447\u043D\u0438\u043A"
    portrait: {fileID: 21300000, guid: 21a4fe3508552fe49b06b01642bf5f81, type: 3}
    text: "\u0422\u0430\u043A \u0438 \u0435\u0441\u0442\u044C. \u0414\u0435\u043D\u044C-\u0434\u0440\u0443\u0433\u043E\u0439
      \u043A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043F\u043E\u0436\u0438\u0432\u0451\u0442,
      \u0430 \u043F\u043E\u0441\u043B\u0435 \u0441\u043D\u043E\u0432\u0430 \u0437\u0430\u043F\u0438\u0440\u0430\u044E\u0442.
      \u041D\u0435\u0434\u0435\u043B\u044F\u043C\u0438 \u043D\u0438 \u0434\u0443\u0448\u0438
      \u043D\u0435 \u0443\u0432\u0438\u0434\u0438\u0448\u044C."
    voiceSoundName: 
  - speakerName: "\u0414\u043C\u0438\u0442\u0440\u0438\u0439 \u041D\u0438\u043A\u043E\u043B\u0430\u0435\u0432\u0438\u0447"
    portrait: {fileID: 21300000, guid: 9ad558a203201074bb13cb55cd3f9177, type: 3}
    text: "\u0410 \u043F\u0440\u0438\u0441\u043B\u0443\u0433\u0430?"
    voiceSoundName: sound_man4
  - speakerName: "\u0411\u0443\u0434\u043E\u0447\u043D\u0438\u043A"
    portrait: {fileID: 21300000, guid: 21a4fe3508552fe49b06b01642bf5f81, type: 3}
    text: "\u041F\u0440\u0435\u0436\u043D\u0435\u0439 \u043F\u0440\u0438\u0441\u043B\u0443\u0433\u0438
      \u0434\u0430\u0432\u043D\u043E \u043D\u0435\u0442. \u041E\u0441\u0442\u0430\u043B\u0438\u0441\u044C
      \u043B\u044E\u0434\u0438, \u0447\u0442\u043E \u0437\u0430 \u0434\u043E\u043C\u043E\u043C
      \u043F\u0440\u0438\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u044E\u0442,
      \u0434\u0430 \u0438 \u0442\u0435 \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442
      \u043D\u0435 \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u043D\u044C."
    voiceSoundName: sound_man4
  - speakerName: "\u0414\u043C\u0438\u0442\u0440\u0438\u0439 \u041D\u0438\u043A\u043E\u043B\u0430\u0435\u0432\u0438\u0447"
    portrait: {fileID: 21300000, guid: 9ad558a203201074bb13cb55cd3f9177, type: 3}
    text: "\u041F\u043E\u043D\u044F\u0442\u043D\u043E\u2026"
    voiceSoundName: sound_man4
