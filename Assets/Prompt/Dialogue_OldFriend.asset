--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3dad4aa2da9780149830cdc74b61d81d, type: 3}
  m_Name: Dialogue_OldFriend
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: "\u041E\u0444\u0438\u0446\u0435\u0440 \u0422\u0440\u0443\u0431\u0435\u0446\u043A\u043E\u0439"
    portrait: {fileID: 21300000, guid: 09f3177430b32e24596a86708ae5e26c, type: 3}
    text: "\u041E\u043F\u044F\u0442\u044C \u043D\u0435 \u0432\u0435\u0437\u0451\u0442!
      \u0410 \u0442\u044B \u0447\u0442\u043E, \u0414\u043C\u0438\u0442\u0440\u0438\u0439
      \u041D\u0438\u043A\u043E\u043B\u0430\u0435\u0432\u0438\u0447, \u043D\u0435
      \u043F\u043E\u0434\u0441\u044F\u0434\u0435\u0448\u044C? \u041F\u043E\u043C\u043D\u0438\u0442\u0435,
      \u043A\u0430\u043A \u0413\u0435\u0440\u043C\u0430\u043D\u043D? \u0422\u043E\u043B\u044C\u043A\u043E
      \u0441\u043C\u043E\u0442\u0440\u0435\u043B, \u043A\u0430\u043A \u043C\u044B
      \u0438\u0433\u0440\u0430\u0435\u043C, \u0430 \u0441\u0430\u043C \u043D\u0438
      \u0440\u0430\u0437\u0443 \u043D\u0435 \u043F\u0440\u0438\u0442\u0440\u043E\u043D\u0443\u043B\u0441\u044F.
      \u0410 \u043A\u0430\u043A \u0432\u0437\u044F\u043B\u0441\u044F \u0437\u0430
      \u043A\u0430\u0440\u0442\u044B \u2014 \u0442\u0430\u043A \u0438 \u0440\u0430\u0441\u0441\u0443\u0434\u043A\u043E\u043C
      \u043F\u043E\u0448\u0430\u0442\u043D\u0443\u043B\u0441\u044F!"
  - speakerName: "\u041E\u0444\u0438\u0446\u0435\u0440 \u0412\u044F\u0437\u0435\u043C\u0441\u043A\u0438\u0439"
    portrait: {fileID: 21300000, guid: 00550d6064d3ca848880c093a2dbfa16, type: 3}
    text: "\u0412\u0435\u0440\u043D\u043E, \u0432\u0435\u0440\u043D\u043E\u2026 \u0421\u0442\u0440\u0430\u043D\u043D\u043E,
      \u043F\u0440\u0430\u0432\u043E \u0441\u043B\u043E\u0432\u043E. \u041E\u043D
      \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u044B\u043B \u0442\u0430\u043A
      \u0440\u0430\u0441\u0447\u0451\u0442\u043B\u0438\u0432, \u0442\u0430\u043A
      \u0445\u043E\u043B\u043E\u0434\u0435\u043D. \u041E\u0442\u043A\u0443\u0434\u0430
      \u0432 \u043D\u0451\u043C \u044D\u0442\u0430 \u0441\u0442\u0440\u0430\u0441\u0442\u044C
      \u044F\u0432\u0438\u043B\u0430\u0441\u044C?"
  - speakerName: "\u041E\u0444\u0438\u0446\u0435\u0440 \u041D\u0430\u0440\u0443\u043C\u043E\u0432"
    portrait: {fileID: 21300000, guid: 635e5f0d6e519d44fa096840c03b676b, type: 3}
    text: "\u0410 \u043C\u043D\u0435 \u0448\u0435\u043F\u043D\u0443\u043B\u0438,
      \u0431\u0443\u0434\u0442\u043E \u043E\u043D \u0431\u0440\u0435\u0434\u0438\u0442
      \u0442\u0440\u0435\u043C\u044F \u043A\u0430\u0440\u0442\u0430\u043C\u0438.
      \u041F\u0440\u044F\u043C \u043A\u0430\u043A \u0432 \u0442\u043E\u043C \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0435
      \u043E \u043F\u043E\u0447\u0438\u0432\u0448\u0435\u0439 \u0433\u0440\u0430\u0444\u0438\u043D\u0435,
      \u0442\u0432\u043E\u0435\u0439 \u0431\u0430\u0431\u0443\u0448\u043A\u0435,
      \u0422\u043E\u043C\u0441\u043A\u0438\u0439. \u041F\u043E\u043C\u043D\u0438\u0448\u044C,
      \u0442\u044B \u043D\u0430\u043C \u0433\u043E\u0432\u043E\u0440\u0438\u043B?"
  - speakerName: "\u041E\u0444\u0438\u0446\u0435\u0440 \u0422\u0440\u0443\u0431\u0435\u0446\u043A\u043E\u0439"
    portrait: {fileID: 21300000, guid: 09f3177430b32e24596a86708ae5e26c, type: 3}
    text: "\u041D\u0435\u0443\u0436\u0435\u043B\u0438 \u0413\u0435\u0440\u043C\u0430\u043D\u043D
      \u0432\u044B\u0432\u0435\u0434\u0430\u043B \u0442\u0430\u0439\u043D\u0443 \u0433\u0440\u0430\u0444\u0438\u043D\u0438
      \u043E \u0442\u0440\u0435\u0445 \u043A\u0430\u0440\u0442\u0430\u0445!"
  - speakerName: "\u041E\u0444\u0438\u0446\u0435\u0440 \u0422\u043E\u043C\u0441\u043A\u0438\u0439"
    portrait: {fileID: 21300000, guid: 1b43d9a1b52d11745932ee72230c1bbc, type: 3}
    text: "\u041F\u0443\u0441\u0442\u043E\u0435. \u0413\u0440\u0430\u0444\u0438\u043D\u044F
      \u0441\u043A\u043E\u043D\u0447\u0430\u043B\u0430\u0441\u044C \u0435\u0449\u0451
      \u0434\u043E \u0435\u0433\u043E \u043F\u043E\u043C\u0435\u0448\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430.
      \u041E\u0442\u043A\u0443\u0434\u0430 \u0435\u043C\u0443 \u0431\u044B\u043B\u043E
      \u0437\u043D\u0430\u0442\u044C \u0435\u0451 \u0442\u0430\u0439\u043D\u0443?
      \u041E\u0434\u043D\u043E \u043C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F
      \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u043C, \u043C\u043D\u043E\u0433\u0438\u0435
      \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438, \u0447\u0442\u043E \u0432\u0438\u0434\u0435\u043B\u0438
      \u0413\u0435\u0440\u043C\u0430\u043D\u043D\u0430 \u0443 \u0434\u043E\u043C\u0430
      \u0433\u0440\u0430\u0444\u0438\u043D\u0438. \u041D\u043E \u043C\u043E\u0436\u0435\u0442
      \u043E\u043D \u0431\u044B\u043B \u0432\u043B\u044E\u0431\u043B\u0435\u043D
      \u0432 \u041B\u0438\u0437\u0430\u0432\u0435\u0442\u0443 \u0418\u0432\u0430\u043D\u043E\u0432\u043D\u0443,
      \u043A\u0430\u043A \u0437\u043D\u0430\u0442\u044C."
  - speakerName: "\u041E\u0444\u0438\u0446\u0435\u0440 \u0412\u044F\u0437\u0435\u043C\u0441\u043A\u0438\u0439"
    portrait: {fileID: 21300000, guid: 00550d6064d3ca848880c093a2dbfa16, type: 3}
    text: "\u0422\u0430\u043A \u041B\u0438\u0437\u0430\u0432\u0435\u0442\u0430 \u0418\u0432\u0430\u043D\u043E\u0432\u043D\u0430
      \u0437\u0430 \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u0437\u0430\u043C\u0443\u0436
      \u0432\u044B\u0448\u043B\u0430. \u0425\u043E\u0442\u0438\u0442\u0435 \u0441\u043A\u0430\u0437\u0430\u0442\u044C
      \u0413\u0435\u0440\u043C\u0430\u043D\u043D \u043E\u0442 \u0442\u043E\u0433\u043E
      \u0438 \u0441\u043E\u0448\u0435\u043B \u0441 \u0443\u043C\u0430?"
  - speakerName: "\u041E\u0444\u0438\u0446\u0435\u0440 \u0422\u0440\u0443\u0431\u0435\u0446\u043A\u043E\u0439"
    portrait: {fileID: 21300000, guid: 09f3177430b32e24596a86708ae5e26c, type: 3}
    text: "\u041C\u043E\u0436\u0435\u0442, \u043E\u043D \u0438 \u0440\u0430\u043D\u044C\u0448\u0435
      \u0431\u044B\u043B \u043D\u0435 \u0432 \u0441\u0435\u0431\u0435, \u0430 \u043C\u044B
      \u043D\u0435 \u043F\u0440\u0438\u043C\u0435\u0442\u0438\u043B\u0438. \u041D\u043E
      \u0441\u043A\u0430\u0436\u0443 \u0432\u0430\u043C \u043E\u0442\u043A\u0440\u043E\u0432\u0435\u043D\u043D\u043E:
      \u0432\u0441\u044F \u044D\u0442\u0430 \u0438\u0441\u0442\u043E\u0440\u0438\u044F
      \u2014 \u0438\u0437 \u0440\u0443\u043A \u0432\u043E\u043D \u0441\u0442\u0440\u0430\u043D\u043D\u0430\u044F!"
  - speakerName: 
    portrait: {fileID: 0}
    text: 
  - speakerName: "\u0414\u043C\u0438\u0442\u0440\u0438\u0439 \u041D\u0438\u043A\u043E\u043B\u0430\u0435\u0432\u0438\u0447
      (\u043C\u044B\u0441\u043B\u0435\u043D\u043E)"
    portrait: {fileID: 21300000, guid: 9ad558a203201074bb13cb55cd3f9177, type: 3}
    text: "\xAB\u041D\u0435 \u043C\u043E\u0433\u0443 \u043F\u043E\u0432\u0435\u0440\u0438\u0442\u044C.
      \u0413\u0435\u0440\u043C\u0430\u043D\u043D \u0431\u044B\u043B \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C, \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
      \u044F \u043C\u043E\u0433 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0431\u0435\u0437\u0443\u043C\u0446\u0435\u043C. \u0421 \u0447\u0435\u0433\u043E
      \u043E\u043D \u0432\u043E\u043E\u0431\u0449\u0435 \u0432\u0437\u044F\u043B\u0441\u044F
      \u0437\u0430 \u043A\u0430\u0440\u0442\u044B? \u0418 \u043F\u043E\u0447\u0435\u043C\u0443
      \u0442\u0435\u043F\u0435\u0440\u044C \u0431\u0440\u0435\u0434\u0438\u0442 \u044D\u0442\u0438\u043C\u0438
      \u0442\u0440\u0435\u043C\u044F \u043A\u0430\u0440\u0442\u0430\u043C\u0438?
      \u0415\u0441\u043B\u0438 \u043E\u043D \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0438\u0441\u043A\u0430\u043B \u0432\u0441\u0442\u0440\u0435\u0447\u0438 \u0441
      \u041B\u0438\u0437\u0430\u0432\u0435\u0442\u043E\u0439 \u0418\u0432\u0430\u043D\u043E\u0432\u043D\u043E\u0439,
      \u0442\u043E, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043E\u043D\u0430
      \u0437\u043D\u0430\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u0435 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445.
      \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u044E \u0435\u0451 \u0440\u0430\u0437\u044B\u0441\u043A\u0430\u0442\u044C.\xBB."
