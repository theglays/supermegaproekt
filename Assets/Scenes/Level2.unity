  m_text: "\u041D\u0430\u0441\u043B\u0435\u0434\u043D\u0438\u043A\u0438 \u0440\u0435\u0434\u043A\u043E
    \u0431\u044B\u0432\u0430\u044E\u0442 \u0432 \u043E\u0441\u043E\u0431\u043D\u044F\u043A\u0435.
    \u041F\u043E\u0441\u043B\u0435 \u0441\u043C\u0435\u0440\u0442\u0438 \u0433\u0440\u0430\u0444\u0438\u043D\u0438
    \u0434\u043E\u043C \u0441\u043B\u043E\u0432\u043D\u043E \u043E\u043F\u0443\u0441\u0442\u0435\u043B
    \u0432\u043C\u0435\u0441\u0442\u0435 \u0441\u043E \u0441\u0432\u043E\u0435\u0439
    \u0445\u043E\u0437\u044F\u0439\u043A\u043E\u0439. \u041E\u0434\u043D\u0430\u043A\u043E
    \u0432\u0441\u0435 \u043D\u0430\u0439\u0434\u0435\u043D\u043D\u044B\u0435 \u043C\u043D\u043E\u0439
    \u0441\u043B\u0435\u0434\u044B \u043F\u043E\u043A\u0430 \u0432\u0435\u0434\u0443\u0442
    \u0438\u043C\u0435\u043D\u043D\u043E \u0441\u044E\u0434\u0430. \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
    \u0440\u0430\u0437\u0433\u0430\u0434\u043A\u0430 \u0431\u0435\u0437\u0443\u043C\u0438\u044F
    \u0413\u0435\u0440\u043C\u0430\u043D\u043D\u0430 \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
    \u0437\u0430 \u044D\u0442\u0438\u043C\u0438 \u0441\u0442\u0435\u043D\u0430\u043C\u0438"
